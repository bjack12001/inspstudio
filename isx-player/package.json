{
  "name": "isx-player",
  "productName": "ISX Player",
  "version": "0.1.0",
  "description": "Reference runtime that loads and executes .isx v1.0 documents (Inspiration Technologies)",
  "author": "Inspiration Technologies",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && tsc -p electron/tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx src/renderer/lib/runtime.test.ts && tsx src/renderer/lib/expr.test.ts && tsx src/renderer/lib/keyboard.test.ts && tsx src/renderer/lib/collections-geo.test.ts",
    "electron:dev": "npm run build && electron .",
    "electron:build": "npm run build && electron-builder"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "papaparse": "^5.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.11.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/papaparse": "^5.3.15",
    "@types/sql.js": "^1.4.11",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "33.2.1",
    "electron-builder": "^25.1.8",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "build": {
    "appId": "com.inspirationtech.isxplayer",
    "productName": "ISX Player",
    "files": ["dist/**", "dist-electron/**", "node_modules/**", "package.json"],
    "asarUnpack": ["node_modules/sql.js/dist/*.wasm"],
    "directories": { "output": "release" },
    "win": { "target": ["nsis"], "signAndEditExecutable": false },
    "mac": { "target": ["dir"], "category": "public.app-category.utilities" }
  }
}
